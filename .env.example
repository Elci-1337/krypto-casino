# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase (public, safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, bypasses RLS; NEVER expose to the client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic / Claude API (server-only) ---
# Used by the admin backend to run Brand Mention / Listicle / Local Push
# skills via the Claude API. Never expose to the client.
ANTHROPIC_API_KEY=

# --- Admin auth ---
# Single shared password protecting /admin. Set to a long random string in
# production.
ADMIN_PASSWORD=

# --- Session signing ---
# 32+ random chars. HMAC-signs the admin session cookie. Server only.
SESSION_SECRET=
