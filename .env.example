# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase (public, safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, bypasses RLS; NEVER expose to the client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Solana ---
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Public on-chain address that collects deposits AND pays out withdrawals.
# Shared with the browser (the deposit dialog builds a transfer to it).
NEXT_PUBLIC_HOUSE_WALLET_ADDRESS=

# Secret key of the house wallet. Accepted formats:
#   * 64-byte JSON array (output of `solana-keygen` or `Keypair.generate()`)
#   * Base58-encoded 64 bytes (Phantom / Solflare "export private key")
# Must resolve to the same public key as NEXT_PUBLIC_HOUSE_WALLET_ADDRESS.
# SERVER-ONLY. Rotate by replacing this value; the module re-loads on cold
# start. In production keep this in a secret manager, never in plaintext.
SOLANA_HOUSE_SECRET_KEY=

# --- Round signing ---
# 32+ random chars. HMAC-signs pre-bet round tokens so the client can hold
# the committed seeds without forging them. Server-only. Rotate to invalidate
# every pending round.
ROUND_SIGNING_SECRET=

# --- Session signing ---
# 32+ random chars. HMAC-signs the SIWS session and challenge cookies. Server
# only. Rotating this forces everyone to re-authenticate.
SESSION_SECRET=
