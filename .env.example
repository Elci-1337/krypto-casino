# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase (public, safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, bypasses RLS; NEVER expose to the client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Solana ---
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Public on-chain address that collects deposits. Shared with the browser so
# the deposit dialog can build transfers client-side, then verified server-
# side against inbound signatures.
NEXT_PUBLIC_HOUSE_WALLET_ADDRESS=

# --- Round signing ---
# 32+ random chars. HMAC-signs pre-bet round tokens so the client can hold
# the committed seeds without forging them. Server-only. Rotate to invalidate
# every pending round.
ROUND_SIGNING_SECRET=
