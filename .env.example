# Copy to .env.local and fill in. Never commit real secrets.

# --- Supabase (public, safe to expose to the browser) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only, bypasses RLS; NEVER expose to the client) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Solana ---
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
# Treasury wallet that receives deposits; server-only.
SOLANA_TREASURY_SECRET_KEY=
