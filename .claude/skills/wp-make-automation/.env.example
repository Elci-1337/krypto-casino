# Copy to .env and fill in. .env is gitignored.

# --- Make.com -----------------------------------------------------------------
MAKE_API_TOKEN=
MAKE_ZONE=eu1
MAKE_TEAM_ID=
MAKE_TEMPLATE_SCENARIO_ID=

# --- Google -------------------------------------------------------------------
# Absolute path to a service-account JSON. The SA needs Sheets + Drive scopes
# and must be granted edit access to GOOGLE_DRIVE_PARENT_FOLDER_ID (if set) and
# to GOOGLE_SHEETS_TEMPLATE_ID (if set).
GOOGLE_SA_JSON_PATH=
GOOGLE_SHEETS_TEMPLATE_ID=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# --- WordPress ----------------------------------------------------------------
# Used by get-wp-key.mjs to retrieve the Make-Connector API key from each site.
# Prefer an Application Password if the site supports it.
WP_USERNAME=
WP_PASSWORD=
