# Copy to .env and fill in. .env is gitignored.

# --- Make.com -----------------------------------------------------------------
MAKE_API_TOKEN=
MAKE_ZONE=eu1
MAKE_TEAM_ID=
MAKE_TEMPLATE_SCENARIO_ID=

# --- Google -------------------------------------------------------------------
# Recommended: OAuth user credentials. Files end up in your own Drive, no
# service-account quota issues. Run scripts/google-auth-bootstrap.mjs once to
# obtain the refresh token.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# Optional fallback: service account (only works for Shared Drives - private
# accounts hit "user's Drive storage quota has been exceeded").
GOOGLE_SA_JSON_PATH=

GOOGLE_SHEETS_TEMPLATE_ID=
GOOGLE_DRIVE_PARENT_FOLDER_ID=

# --- WordPress ----------------------------------------------------------------
# Used by get-wp-key.mjs to retrieve the Make-Connector API key from each site.
# Prefer an Application Password if the site supports it.
WP_USERNAME=
WP_PASSWORD=
