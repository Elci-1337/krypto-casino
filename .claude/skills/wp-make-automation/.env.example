# --- Make.com -----------------------------------------------------------------
MAKE_API_TOKEN=
MAKE_ZONE=eu1
MAKE_TEAM_ID=
MAKE_TEMPLATE_SCENARIO_ID=
MAKE_WP_ACCOUNT_TYPE=wordpress

# --- Google Sheets ------------------------------------------------------------
# No API access needed. The Make scenario reuses the Google connection from the
# template, so the user's own Google account stays the file owner.
# You create one sheet per site manually and pass its ID via --sheet-id.
# (Optional default for runs without --sheet-id:)
GOOGLE_SHEET_ID=

# --- WordPress (optional, for auto-fetching the Make-Connector key) -----------
WP_USERNAME=
WP_PASSWORD=
